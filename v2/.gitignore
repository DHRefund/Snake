# Unity Meta for ignored artifacts
*.pidb.meta
*.pdb.meta
*.mdb.meta

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
